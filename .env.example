# Copy this file to .env and fill in the real values.
# Never commit the .env file.

# Environment: development | production | test
APP_ENV=development

# Base URL of the backend that serves the road graph.
# Locally the backend runs on port 3000; in Render, use the deployed backend URL.
BACKEND_URL=http://localhost:3000

# Shared token for the backend internal endpoints (used from Stage 2, block 5).
# It must be the same value as INTERNAL_TOKEN in the backend. Leave it empty here.
INTERNAL_TOKEN=
