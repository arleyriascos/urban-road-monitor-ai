# Copy this file to .env and fill in the real values.
# Never commit the .env file.

# Environment: development | production | test
APP_ENV=development

# Base URL of the backend that serves the road graph.
# Locally the backend runs on port 3000; in Render, use the deployed https:// backend URL.
# With APP_ENV=production it must start with https://, so the token is never sent in clear text.
BACKEND_URL=http://localhost:3000

# Shared token with the backend (at least 32 characters): it protects POST /routes and is
# used to download the road graph. It must be the same value as INTERNAL_TOKEN in the backend.
# Empty turns POST /routes off (it answers 404). Leave it empty here; never commit it.
INTERNAL_TOKEN=

# Optional: how far, in meters, a clicked point may be from the road network (default 200).
# MAX_SNAP_DISTANCE_M=200
